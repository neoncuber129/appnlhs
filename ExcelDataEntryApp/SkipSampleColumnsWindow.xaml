<Window x:Class="ExcelDataEntryApp.SkipSampleColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="480"
        Width="520"
        MinHeight="360"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HelpTextBlock"
                   TextWrapping="Wrap"
                   Foreground="#374151" />

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <Button Padding="10,4"
                    Click="ScanMarkerColumns_Click"
                    Content="Gợi ý từ ký hiệu s" />
            <Button Margin="8,0,0,0"
                    Padding="10,4"
                    Click="SelectAll_Click"
                    Content="Chọn tất cả" />
            <Button Margin="8,0,0,0"
                    Padding="10,4"
                    Click="UnselectAll_Click"
                    Content="Bỏ chọn" />
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ColumnsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,3,0,3"
                                      Content="{Binding Display}"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SavedHintTextBlock"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Tick chọn cột, sau đó bấm Lưu profile (file cạnh thư mục app)" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Padding="12,4"
                        Click="SaveProfile_Click"
                        Content="Lưu profile" />
                <Button Padding="12,4"
                        IsDefault="True"
                        IsCancel="True"
                        Content="Đóng" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
