<Window x:Class="ExcelDataEntryApp.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập liệu"
        Height="181"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   Text="Nhập liệu:"
                   FontSize="13"
                   Foreground="#111827" />

        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Height="32"
                 Margin="0,12,0,0"
                 Padding="8,6"
                 FontSize="12"
                 BorderBrush="#D1D5DB"
                 BorderThickness="1"
                 Foreground="#111827" />

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="OK"
                    Background="#10B981"
                    Foreground="White"
                    FontSize="12"
                    Click="OkButton_Click"
                    IsDefault="True" />
            <Button x:Name="CancelButton"
                    Width="100"
                    Height="32"
                    Content="Hủy"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    FontSize="12"
                    Click="CancelButton_Click"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
