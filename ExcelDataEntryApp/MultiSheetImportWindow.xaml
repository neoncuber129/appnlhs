<Window x:Class="ExcelDataEntryApp.MultiSheetImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập nhiều sheet"
        Height="620"
        Width="1120"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="14"
                   FontWeight="SemiBold"
                   Text="Chọn các sheet cần ghép và cấu hình tiêu đề / dòng nhập liệu" />

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <CheckBox x:Name="ShowHiddenSheetsCheckBox"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Content="Hiện sheet ẩn"
                      Checked="ShowHiddenSheets_Changed"
                      Unchecked="ShowHiddenSheets_Changed" />
            <CheckBox x:Name="AutoSkipBlankCheckBox"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      Content="Tự bỏ qua header = blank" />
            <CheckBox x:Name="SuggestionsCheckBox"
                      VerticalAlignment="Center"
                      Content="Bật gợi ý theo cột" />
        </StackPanel>

        <DataGrid x:Name="SheetsDataGrid"
                  Grid.Row="2"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CellEditEnding="SheetsDataGrid_CellEditEnding"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Chọn"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="50" />
                <DataGridTextColumn Header="Sheet"
                                    Binding="{Binding SheetName}"
                                    IsReadOnly="True"
                                    Width="160" />
                <DataGridTextColumn Header="Tiêu đề từ hàng"
                                    Binding="{Binding HeaderFirstRow, UpdateSourceTrigger=PropertyChanged}"
                                    Width="110" />
                <DataGridTextColumn Header="Tiêu đề đến hàng"
                                    Binding="{Binding HeaderLastRow, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTextColumn Header="Dòng bắt đầu nhập"
                                    Binding="{Binding FirstDataRow, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTextColumn Header="Dòng mẫu"
                                    Binding="{Binding SampleRow, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90" />
                <DataGridTemplateColumn Header="Sheet tên" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="NameSheetGroup"
                                         HorizontalAlignment="Center"
                                         IsChecked="{Binding IsNameSheet, UpdateSourceTrigger=PropertyChanged}"
                                         Checked="NameSheetRadio_Checked" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cột tên" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ColumnOptions}"
                                      SelectedValue="{Binding NameColumnIndex, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="ColumnIndex"
                                      DisplayMemberPath="."
                                      IsEnabled="{Binding IsNameSheet}"
                                      MinWidth="200" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Ok_Click"
                    Content="OK"
                    IsDefault="True" />
            <Button Width="100"
                    Height="32"
                    Click="Cancel_Click"
                    Content="Hủy"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
