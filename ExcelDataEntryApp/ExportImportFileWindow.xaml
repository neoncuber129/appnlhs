<Window x:Class="ExcelDataEntryApp.ExportImportFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất file import"
        Height="460"
        Width="680"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="Xuất bản sao Excel sẵn sàng import" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#374151"
                   Text="Bổ sung ô trống từ hàng mẫu. Cột $ đã cấu hình: Nam/giới tính trống không lấy dòng mẫu; Nữ vẫn lấy." />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Cột giới tính:" />
            <ComboBox x:Name="GenderColumnComboBox"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      MinHeight="30"
                      DisplayMemberPath="Name"
                      SelectionChanged="GenderColumnComboBox_OnSelectionChanged" />
            <Button x:Name="SkipColumnsButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="10,4"
                    MinHeight="30"
                    Click="OpenSkipColumns_Click"
                    ToolTip="Cột $ không lấy dòng mẫu khi Nam"
                    Content="Cột $ Nam" />
            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="10,4"
                    MinHeight="30"
                    Click="SaveProfile_Click"
                    ToolTip="Lưu cấu hình vào file cạnh thư mục app"
                    Content="Lưu profile" />
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="10"
                CornerRadius="6"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Background="#F8FAFC">
            <TextBlock x:Name="PreviewTextBlock"
                       TextWrapping="Wrap"
                       Foreground="#1F2937" />
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="File xuất:" />
            <TextBox x:Name="OutputPathTextBox"
                     Grid.Column="1"
                     Margin="8,0"
                     IsReadOnly="True" />
            <Button Grid.Column="2"
                    Padding="10,4"
                    Click="BrowseOutput_Click"
                    Content="Chọn file" />
        </Grid>

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    Content="Hủy"
                    IsCancel="True" />
            <Button Width="120"
                    Height="32"
                    Click="Export_Click"
                    Content="Xuất file"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
