<Window x:Class="ExcelDataEntryApp.ExportHsskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất HSSK"
        Height="640"
        Width="760"
        MinHeight="520"
        MinWidth="620"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="14"
                   FontWeight="SemiBold"
                   Text="Xuất hồ sơ sức khỏe theo mẫu Word (.docx)" />

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Mẫu Word:" />
            <TextBox x:Name="TemplatePathTextBox"
                     Grid.Column="1"
                     Margin="8,0"
                     IsReadOnly="True" />
            <Button Grid.Column="2"
                    Padding="10,4"
                    Click="BrowseTemplate_Click"
                    Content="Chọn file" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Thư mục xuất:" />
            <TextBox x:Name="OutputFolderTextBox"
                     Grid.Column="1"
                     Margin="8,0" />
            <Button Grid.Column="2"
                    Padding="10,4"
                    Click="SetDefaultOutputFolder_Click"
                    Content="Mặc định" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Cột giới tính:" />
            <ComboBox x:Name="GenderColumnComboBox"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      MinHeight="30"
                      DisplayMemberPath="Name"
                      SelectionChanged="GenderColumnComboBox_OnSelectionChanged" />
            <StackPanel Grid.Column="2"
                        Margin="8,0,0,0"
                        Orientation="Horizontal">
                <Button x:Name="SkipColumnsButton"
                        Padding="10,4"
                        MinHeight="30"
                        Click="OpenSkipColumns_Click"
                        ToolTip="Cột $ không lấy dòng mẫu khi Nam"
                        Content="Cột $ Nam" />
                <Button Margin="8,0,0,0"
                        Padding="10,4"
                        MinHeight="30"
                        Click="SaveProfile_Click"
                        ToolTip="Lưu cấu hình xuất HSSK vào file cạnh thư mục app"
                        Content="Lưu profile" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Ghi chú tên file:" />
                <TextBox x:Name="FileNoteTextBox"
                         Grid.Column="1"
                         Margin="8,0,0,0" />
                <CheckBox x:Name="ExportToSingleFileCheckBox"
                          Grid.Column="3"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Content="Xuất nhiều tên vào 1 file"
                          IsChecked="False" />
                <TextBox x:Name="CombinedFileNameTextBox"
                         Grid.Column="4"
                         ToolTip="Tên file khi xuất nhiều tên vào một file"
                         Text="HSSK_TongHop" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,10,0,0"
                Padding="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Chọn dòng cần xuất (theo tên)" />
                <TextBox x:Name="SearchTextBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         MinHeight="30"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged" />
                <ListBox x:Name="RecordsListBox"
                         Grid.Row="2"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Content="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6"
                    Margin="0,10,0,0">
            <TextBlock x:Name="ExportProgressTextBlock"
                       Text="Tiến độ: 0%"
                       Visibility="Collapsed" />
            <ProgressBar x:Name="ExportProgressBar"
                         Margin="0,6,0,0"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Padding="10,4"
                    Margin="0,0,8,0"
                    Click="ExportHeadersToExcel_Click"
                    Content="Xuất tiêu đề $" />
            <Button Padding="10,4"
                    Margin="0,0,8,0"
                    Click="SelectAll_Click"
                    Content="Chọn tất cả" />
            <Button Padding="10,4"
                    Margin="0,0,8,0"
                    Click="UnselectAll_Click"
                    Content="Bỏ chọn tất cả" />
            <Button Padding="12,4"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Export_Click"
                    Content="Xuất" />
            <Button Padding="12,4"
                    IsCancel="True"
                    Content="Đóng" />
        </StackPanel>
    </Grid>
</Window>
